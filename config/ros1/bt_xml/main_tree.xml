<root BTCPP_format="4">
  <include path="./lge_insp.xml" />
  <include path="./le_insp_opening.xml" />
  <include path="./le_opening.xml" />
  <include path="./lge_homing.xml" />
  <include path="./active_homing.xml" />
  <include path="./lnav.xml" />
  <BehaviorTree ID="MainTree">
    <ReactiveFallback>
      <Sequence>
        <SwitchToLocalNavigation/>
        <SubTree ID="lnav"/>
      </Sequence>
      <Sequence>
        <ReactiveFallback>
          <HomingCheck/>
          <Sequence>
            <SubTree ID="lge_homing"/>
            <AlwaysFailure/>
          </Sequence>
        </ReactiveFallback>
        <SubTree ID="acthoming"/>
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>
</root>
